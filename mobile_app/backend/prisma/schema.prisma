generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PROFESSOR
  STUDENT
}

enum SessionStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  POSTPONED
  CANCELLED
}

enum AttendanceStatus {
  UNMARKED
  PRESENT
  ABSENT
  LATE
  JUSTIFIED
}

enum SessionMasterStatus {
  ACTIVE
  ARCHIVED
}

enum SessionExceptionType {
  DELETED
  MODIFIED
}

enum MarkedBy {
  PROFESSOR
  STUDENT
  ADMIN
  SYSTEM
}

enum ScanMethod {
  MANUAL
  QR
  QR_SESSION
  QR_STUDENT
  IMPORT
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String        @map("password_hash")
  firstName    String
  lastName     String
  role         UserRole
  identifier   String?
  groupId      String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  group             Group?        @relation(fields: [groupId], references: [id])
  sessionsAsProfessor Session[]   @relation("ProfessorSessions")
  sessionMasters    SessionMaster[]
  attendance        Attendance[]
  refreshTokens     RefreshToken[]

  @@index([role])
}

model Group {
  id           String    @id @default(cuid())
  name         String
  code         String
  level        String
  department   String
  studentCount Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  students User[]
  sessions Session[]
  sessionMasters SessionMaster[]
}

model Module {
  id         String   @id @default(cuid())
  name       String
  code       String
  description String?
  credits    Int?
  totalHours Int?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sessions Session[]
  sessionMasters SessionMaster[]
}

model Room {
  id             String   @id @default(cuid())
  name           String
  code           String
  capacity       Int
  building       String?
  floor          Int?
  hasProjector   Boolean  @default(false)
  hasComputers   Boolean  @default(false)
  latitude       Float?
  longitude      Float?
  geofenceRadius Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions Session[]
  sessionMasters SessionMaster[]
}

model Session {
  id              String        @id @default(cuid())
  moduleId        String
  professorId     String
  groupId         String
  roomId          String
  sessionDate     DateTime
  startTime       String
  endTime         String
  status          SessionStatus @default(SCHEDULED)
  currentQrToken  String?
  qrTokenExpiresAt DateTime?
  presentCount    Int           @default(0)
  absentCount     Int           @default(0)
  lateCount       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  module    Module   @relation(fields: [moduleId], references: [id])
  professor User     @relation("ProfessorSessions", fields: [professorId], references: [id])
  group     Group    @relation(fields: [groupId], references: [id])
  room      Room     @relation(fields: [roomId], references: [id])
  attendance Attendance[]

  @@index([sessionDate])
  @@index([professorId])
  @@index([groupId])
}

model Attendance {
  sessionId   String
  studentId   String
  status      AttendanceStatus @default(UNMARKED)
  markedBy    MarkedBy          @default(PROFESSOR)
  scanMethod  ScanMethod        @default(MANUAL)
  gpsVerified Boolean           @default(false)
  gpsLatitude Float?
  gpsLongitude Float?
  lateMinutes Int?
  markedAt    DateTime          @default(now())

  session Session @relation(fields: [sessionId], references: [id])
  student User    @relation(fields: [studentId], references: [id])

  @@id([sessionId, studentId])
  @@index([studentId])
  @@index([status])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @map("token_hash")
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SessionMaster {
  id                 String              @id @default(cuid())
  seriesKey          String
  parentMasterId     String?
  moduleId           String
  professorId        String
  groupId            String
  roomId             String
  weekday            Int
  startTime          String
  endTime            String
  effectiveStartDate DateTime
  effectiveEndDate   DateTime?
  status             SessionMasterStatus @default(ACTIVE)
  archivedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  parentMaster       SessionMaster?      @relation("SessionMasterLineage", fields: [parentMasterId], references: [id])
  childMasters       SessionMaster[]     @relation("SessionMasterLineage")
  module             Module              @relation(fields: [moduleId], references: [id])
  professor          User                @relation(fields: [professorId], references: [id])
  group              Group               @relation(fields: [groupId], references: [id])
  room               Room                @relation(fields: [roomId], references: [id])
  exceptions         SessionException[]

  @@index([seriesKey])
  @@index([moduleId])
  @@index([professorId])
  @@index([groupId])
  @@index([roomId])
  @@index([weekday, effectiveStartDate, effectiveEndDate])
}

model SessionException {
  id                  String              @id @default(cuid())
  masterId            String
  occurrenceDate      DateTime
  type                SessionExceptionType
  originalDate        DateTime
  originalStartTime   String
  originalEndTime     String
  overrideDate        DateTime?
  overrideStartTime   String?
  overrideEndTime     String?
  overrideModuleId    String?
  overrideProfessorId String?
  overrideGroupId     String?
  overrideRoomId      String?
  note                String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  master SessionMaster @relation(fields: [masterId], references: [id])

  @@unique([masterId, occurrenceDate])
  @@index([occurrenceDate])
  @@index([type])
}
